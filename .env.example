# Public build-time browser values.
PUBLIC_TURNSTILE_SITE_KEY=

# Public browser credentials. Row Level Security must remain enabled.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Shared server runtime values. Never commit real secret values.
SUPABASE_PUBLISHABLE_KEY=
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUBMISSION_FINGERPRINT_SECRET=
GITHUB_DATA_PUBLICATION_TOKEN=
GITHUB_SITE_DEPLOY_TOKEN=

# Vercel Next-development build/runtime configuration.
PERKCOMMONS_DATA_REPOSITORY=https://github.com/CodWasTaken/data.git
PERKCOMMONS_DATA_REF=main
GITHUB_DATA_REPOSITORY=CodWasTaken/data
GITHUB_DATA_BRANCH=main
GITHUB_HEAD_OWNER=CodWasTaken
GITHUB_SITE_REPOSITORY=CodWasTaken/site
FORK_ONLY_MODE=true
VERCEL_DEPLOY_HOOK_URL=
CRON_SECRET=
