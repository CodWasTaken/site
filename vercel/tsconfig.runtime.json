{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "../api/**/*.ts",
    "../middleware.ts",
    "./runtime-*.ts",
    "../worker/lib/**/*.ts",
    "../worker/routes/**/*.ts",
    "../src/lib/taxonomy.ts",
    "../src/generated/**/*.ts"
  ],
  "exclude": ["../node_modules", "../worker/tests"]
}
