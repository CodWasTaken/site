{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "../vercel/**/*.ts",
    "../worker/lib/**/*.ts",
    "../worker/routes/**/*.ts",
    "../src/lib/taxonomy.ts",
    "../src/generated/**/*.ts"
  ],
  "exclude": ["../node_modules", "../worker/tests"]
}
